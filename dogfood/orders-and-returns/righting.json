{
  "preset": "volatility@1",
  "coverage": ["src/**/*.ts"],
  "aliases": [
    { "name": "Screen", "role": "Client", "directorySegments": ["screen"] },
    { "name": "Workflow", "role": "Manager", "directorySegments": ["workflow"] },
    { "name": "Rules", "role": "Engine", "directorySegments": ["rules"] },
    { "name": "Gateway", "role": "ResourceAccess", "directorySegments": ["gateway"] },
    { "name": "Api", "role": "Resource", "directorySegments": ["api"] },
    { "name": "Shared", "role": "Utility", "directorySegments": ["shared"] }
  ],
  "compositionRoots": ["main"],
  "variations": ["contextFirewall"],
  "scopes": [
    { "kind": "context", "name": "orders", "path": "src/orders/**" },
    { "kind": "context", "name": "returns", "path": "src/returns/**" },
    { "kind": "shared", "path": "src/shared/**" },
    { "kind": "unscoped", "path": "src/application/**" }
  ]
}
